{
  "name": "[공통] n8n 워크플로우 GitHub 백업 (Schedule)",
  "nodes": [
    {
      "id": "trg-schedule-2101",
      "name": "매일 21:50",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "50 21 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "n8n-getall-2102",
      "name": "워크플로우 목록 조회",
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "parameters": {
        "resource": "workflow",
        "operation": "getAll",
        "returnAll": true
      },
      "credentials": {
        "n8nApi": {
          "id": "PLACEHOLDER_N8N_API_CRED",
          "name": "n8n API"
        }
      }
    },
    {
      "id": "loop-batch-2103",
      "name": "워크플로우 순회",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        680,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "code-prepare-2104",
      "name": "백업 파일 정보 생성",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const wf = $json;\nconst safeName = (wf.name || `workflow-${wf.id}`).replace(/[\\\\/:*?\"<>|]/g, '_').trim();\nconst filePath = `n8n/workflows/${safeName}.json`;\nconst content = JSON.stringify({\n  name: wf.name,\n  nodes: wf.nodes,\n  connections: wf.connections,\n  settings: wf.settings,\n  staticData: wf.staticData || null\n}, null, 2);\n\nreturn {\n  json: {\n    workflowId: wf.id,\n    workflowName: wf.name,\n    filePath,\n    content\n  }\n};"
      }
    },
    {
      "id": "github-get-2105",
      "name": "기존 파일 확인",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        1120,
        200
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "resource": "file",
        "operation": "get",
        "owner": {
          "__rl": true,
          "value": "YOUR_GITHUB_USERNAME",
          "mode": "id"
        },
        "repository": {
          "__rl": true,
          "value": "YOUR_GITHUB_REPO",
          "mode": "id"
        },
        "filePath": "={{ $json.filePath }}",
        "additionalParameters": {
          "reference": {
            "branch": "main"
          }
        }
      },
      "credentials": {
        "githubApi": {
          "id": "PLACEHOLDER_GITHUB_CRED",
          "name": "GitHub account"
        }
      }
    },
    {
      "id": "github-edit-2106",
      "name": "파일 업데이트",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        1340,
        120
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "file",
        "operation": "edit",
        "owner": {
          "__rl": true,
          "value": "YOUR_GITHUB_USERNAME",
          "mode": "id"
        },
        "repository": {
          "__rl": true,
          "value": "YOUR_GITHUB_REPO",
          "mode": "id"
        },
        "filePath": "={{ $('백업 파일 정보 생성').item.json.filePath }}",
        "fileContent": "={{ $('백업 파일 정보 생성').item.json.content }}",
        "commitMessage": "=n8n 워크플로우 자동 백업: {{ $('백업 파일 정보 생성').item.json.workflowName }} ({{ $now.format('yyyy-MM-dd HH:mm') }})",
        "fileSha": "={{ $json.sha }}",
        "branch": {
          "branch": "main"
        }
      },
      "credentials": {
        "githubApi": {
          "id": "PLACEHOLDER_GITHUB_CRED",
          "name": "GitHub account"
        }
      }
    },
    {
      "id": "github-create-2107",
      "name": "파일 생성",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        1340,
        300
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "file",
        "operation": "create",
        "owner": {
          "__rl": true,
          "value": "YOUR_GITHUB_USERNAME",
          "mode": "id"
        },
        "repository": {
          "__rl": true,
          "value": "YOUR_GITHUB_REPO",
          "mode": "id"
        },
        "filePath": "={{ $('백업 파일 정보 생성').item.json.filePath }}",
        "fileContent": "={{ $('백업 파일 정보 생성').item.json.content }}",
        "commitMessage": "=n8n 워크플로우 자동 백업(신규): {{ $('백업 파일 정보 생성').item.json.workflowName }} ({{ $now.format('yyyy-MM-dd HH:mm') }})",
        "branch": {
          "branch": "main"
        }
      },
      "credentials": {
        "githubApi": {
          "id": "PLACEHOLDER_GITHUB_CRED",
          "name": "GitHub account"
        }
      }
    },
    {
      "id": "slack-notify-2108",
      "name": "Slack 완료 알림",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        900,
        460
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#n8n",
          "mode": "name"
        },
        "text": "=:floppy_disk: n8n 워크플로우 GitHub 백업이 완료되었습니다. ({{ $now.format('yyyy-MM-dd HH:mm') }})",
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": {
          "id": "jcwy7idEiVodxf5l",
          "name": "Slack account"
        }
      }
    }
