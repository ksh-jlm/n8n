        "n8nApi": {
          "id": "VDhXI3O4QS9FyfCo",
          "name": "n8n API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// n8n 노드(Workflow: Get)가 리턴한 전체 워크플로우 객체\nconst wf = $json;\n\n// 파일명에 쓸 수 없는 문자 정리\nconst safeName = String(wf.name || wf.id)\n  .replace(/[\\\\/:*?\"<>|]/g, '_')\n  .replace(/\\s+/g, '_')\n  .trim();\n\n// git 저장소 내 경로\nconst repoPath = `n8n/workflows/${safeName}_workflow.json`;\n\n// export 포맷과 가깝게: 실행에 불필요한 필드 제거\nconst clean = {\n  name: wf.name,\n  nodes: wf.nodes,\n  connections: wf.connections,\n  settings: wf.settings || {},\n  staticData: wf.staticData ?? null,\n  pinData: wf.pinData ?? {},\n  meta: wf.meta ?? null,\n  tags: (wf.tags || []).map(t => (typeof t === 'string' ? t : t.name))\n};\n\nconst now = $now.setZone('Asia/Seoul').toFormat('yyyy-MM-dd HH:mm');\n\nreturn {\n  json: {\n    repoPath,\n    fileContent: JSON.stringify(clean, null, 2) + '\\n',\n    commitMessage: `백업: ${wf.name} (${now})`\n  }\n};"
      },
      "id": "prep",
      "name": "커밋 데이터 준비",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
