        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "n8n"
        },
        "filePath": "={{ $json.repoPath }}",
        "binaryData": false,
        "fileContent": "={{ $json.fileContent }}",
        "commitMessage": "={{ $json.commitMessage }}"
      },
