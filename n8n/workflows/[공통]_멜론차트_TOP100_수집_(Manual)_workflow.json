    {
      "parameters": {
        "jsCode": "// FireCrawl 응답에서 HTML 본문 추출\nconst response = $input.first().json;\nconst html = response.data?.html || response.html || '';\n\nif (!html) {\n  throw new Error('스크랩 결과에서 HTML을 찾을 수 없습니다. FireCrawl 노드의 Formats에 Html이 포함되어 있는지 확인하세요.');\n}\n\nfunction decodeEntities(str) {\n  return str\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .trim();\n}\n\nconst results = [];\n\n// 멜론차트 각 곡은 <tr> 안에 rank(순위), rank01(곡제목 a태그), rank02(가수 a태그) 클래스로 구성됨\n// 실제 마크업은 class=\"rank \"(끝에 공백), class=\"ellipsis rank01\"처럼 다른 클래스와 함께 오므로\n// 단어 경계(\\b)로 rank/rank01/rank02를 매칭한다\nconst rowRegex = /<tr[^>]*data-song-no=\"(\\d+)\"[\\s\\S]*?<\\/tr>/g;\nlet rowMatch;\n\nwhile ((rowMatch = rowRegex.exec(html)) !== null) {\n  const row = rowMatch[0];\n\n  // 순위\n  const rankMatch = row.match(/class=\"[^\"]*\\brank\\b[^\"]*\"[^>]*>\\s*([\\d,]+)/);\n  // 곡제목: rank01 클래스 영역 안의 a 태그 텍스트\n  const titleBlockMatch = row.match(/class=\"[^\"]*\\brank01\\b[^\"]*\"[\\s\\S]*?<a[^>]*title=\"([^\"]+?)\\s*재생\"/);\n  // 가수: rank02 클래스 영역 안의 a 태그 텍스트\n  const artistBlockMatch = row.match(/class=\"[^\"]*\\brank02\\b[^\"]*\"[\\s\\S]*?<a[^>]*title=\"([^\"]+?)\\s*(?:페이지|아티스트)?\">([^<]+)</);\n\n  if (rankMatch && titleBlockMatch) {\n    const rank = parseInt(rankMatch[1].replace(/,/g, ''), 10);\n    const title = decodeEntities(titleBlockMatch[1]);\n    const artist = artistBlockMatch ? decodeEntities(artistBlockMatch[2] || artistBlockMatch[1]) : '';\n\n    results.push({\n      json: {\n        순위: rank,\n        곡제목: title,\n        가수: artist,\n        수집일시: new Date().toISOString()\n      }\n    });\n  }\n}\n\nif (results.length === 0) {\n  throw new Error('파싱된 곡이 없습니다. 멜론 차트 페이지 구조가 변경되었을 수 있으니 HTML 원본을 확인하세요.');\n}\n\nreturn results;"
      },
