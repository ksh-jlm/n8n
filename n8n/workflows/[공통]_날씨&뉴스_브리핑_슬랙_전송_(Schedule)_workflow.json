    {
      "id": "code-format-0004",
      "name": "메시지 포맷",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const weather = $('날씨 조회').first().json;\nconst rssXml = $('인기 뉴스 조회').first().json.data || $('인기 뉴스 조회').first().json;\n\nconst current = weather.current_condition ? weather.current_condition[0] : {};\nconst area = weather.nearest_area ? weather.nearest_area[0] : {};\nconst areaName = area.areaName ? area.areaName[0].value : 'Seoul';\nconst tempC = current.temp_C || 'N/A';\nconst feelsLike = current.FeelsLikeC || 'N/A';\nconst desc = current.weatherDesc ? current.weatherDesc[0].value : 'N/A';\nconst humidity = current.humidity || 'N/A';\n\nconst xmlString = typeof rssXml === 'string' ? rssXml : JSON.stringify(rssXml);\nconst itemBlocks = [...xmlString.matchAll(/<item>([\\s\\S]*?)<\\/item>/g)].map(m => m[1]);\nconst newsTitles = itemBlocks.slice(0, 5).map(block => {\n  const m = block.match(/<title>(?:<!\\[CDATA\\[)?(.*?)(?:\\]\\]>)?<\\/title>/);\n  return m ? m[1] : '';\n}).filter(Boolean);\n\nconst newsLines = newsTitles.map((t, i) => `${i + 1}. ${t}`).join('\\n');\n\nconst today = new Date().toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' });\n\nconst slackText = `:sunny: *${today} 아침 브리핑*\\n\\n*[${areaName} 날씨]*\\n${desc}, 현재 ${tempC}°C (체감 ${feelsLike}°C), 습도 ${humidity}%\\n\\n*[오늘의 인기 뉴스 TOP 5]*\\n${newsLines}`;\n\nreturn [{ json: { slackText } }];"
      }
    },
